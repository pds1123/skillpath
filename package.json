{
  "name": "skillpath",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-public-data.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite",
    "dev:api": "dotnet run --project backend/SkillPath.Api",
    "db:export": "node scripts/export-question-bank.mjs",
    "db:import:ctfl": "node scripts/import-istqb-ctfl.mjs",
    "db:import:ctfl:merge": "node scripts/import-istqb-ctfl-merged.mjs",
    "prebuild": "npm run prepare:data",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:backend",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:backend": "dotnet test backend/SkillPath.Api.Tests/SkillPath.Api.Tests.csproj --configuration Release",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run build && npm run test:unit:coverage && npm run test:backend && npm run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^5.0.0"
  }
}
